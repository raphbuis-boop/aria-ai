{
  "name": "aria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "build:ios": "cp next.config.mjs next.config.web.bak && cp next.config.mobile.mjs next.config.mjs && next build --webpack; mv next.config.web.bak next.config.mjs",
    "ios:sync": "npm run build:ios && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash scripts/db/test.sh"
  },
